<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /agentverify/

  # A page folder asked for without its ending slash (e.g. /agentverify/pricing):
  # add the slash. Otherwise the main aimodularity.com app answers instead.
  # The query string (e.g. ?id=...) is kept.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /agentverify/$1/ [R=301,L]

  # Anything that is not a real file or page folder: show the "Page not found" page with a
  # real 404 status (404.php sends the status, then the page). Answered here, so the request
  # never reaches the main aimodularity.com app (which adds a slash and would loop).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [L]
</IfModule>

ErrorDocument 404 /agentverify/404.html
