      "expected": {
        "status": "VALID"
      }
    },
    {
      "name": "valid.low-s",
      "description": "DELIBERATE: a low-S signature verifies under legacy semantics.",
      "from": "base",
      "expected": {
        "status": "VALID"
      }
    },
    {
      "name": "valid.high-s",
      "description": "DELIBERATE: the (r, n - s) twin of the SAME signature also verifies under legacy semantics. The low-S rule applies to the profile-attestation type only; legacy verification is unchanged.",
