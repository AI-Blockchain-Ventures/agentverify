# Copy this file to .dev.vars (already gitignored) and fill in real local values, or run:
#   node workers/api/scripts/generate-dev-signing-key.mjs
# to generate a throwaway DEV-ONLY attestation signing key automatically.
#
# NEVER put real values in THIS file — it is the committed template. Real values only ever go in
# your own local .dev.vars, which .gitignore excludes by name.

# DEV ONLY. Never a production signing key. Generated locally, never committed.
ATTESTATION_SIGNING_PRIVATE_KEY_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","key_ops":["sign"]}
ATTESTATION_ISSUER=agentverify-dev

# Profile-attestation signing key (workers/api/src/profileAttestationSigning.ts) -- a DIFFERENT, domain-
# separated key from the legacy ATTESTATION_SIGNING_PRIVATE_KEY_JWK above; both may be configured at once,
# neither is derived from the other. Generate a throwaway DEV-ONLY key automatically with:
#   node workers/api/scripts/generate-dev-profile-attestation-key.mjs
# which appends the four lines below (as PRIVATE_KEY_JWK_B64, not the plain-JSON form) to your local
# .dev.vars, including a correctly-derived PROFILE_ATTESTATION_EXPECTED_KEY_ID for that specific dev key.
# DEV ONLY. Never a production signing key. Generated locally, never committed. See
# docs/profile-attestation-production-checklist.md for the production equivalent of every line below.
PROFILE_ATTESTATION_SIGNING_PRIVATE_KEY_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","key_ops":["sign"]}
PROFILE_ATTESTATION_ISSUER=agentverify-profile-dev
PROFILE_ATTESTATION_KEY_PURPOSE=agentverify-profile-v1
# Optional. Left commented out (truly UNSET, not present-but-empty -- an empty VALUE is treated as
# misconfiguration and refuses to sign, on purpose) so the check is skipped until you deliberately want it.
# Uncomment and fill in once you know a specific dev key's own identity, or set to an intentionally wrong
# value to exercise the key-identity-mismatch refusal path.
# PROFILE_ATTESTATION_EXPECTED_KEY_ID=

# Stripe TEST-mode configuration — required only to exercise real checkout/webhook/portal locally.
# See "Local Review Billing" in docs/billing-setup.md for the full walkthrough. Use TEST-mode
# values ONLY (sk_test_..., whsec_..., a test-mode price/portal configuration id) — never a live
# key here. Leave these unset to keep npm run review's honest "LOCAL REVIEW: billing needs Stripe
# test configuration" message instead.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
